{
  "name": "react95",
  "version": "0.0.0-development",
  "description": "Refreshed Windows95 UI components for modern web apps - React95",
  "keywords": [
    "react",
    "styled-components",
    "windows95",
    "components",
    "vaporwave"
  ],
  "author": "Artur Bień <artur.bien+react95@gmail.com> (https://www.linkedin.com/in/arturbien/)",
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/react95"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/arturbien"
    }
  ],
  "license": "MIT",
  "repository": "git@github.com:arturbien/React95.git",
  "homepage": "https://react95.io",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes/index.d.mts",
        "default": "./dist/themes/index.mjs"
      },
      "require": {
        "types": "./dist/themes/index.d.ts",
        "default": "./dist/themes/index.js"
      }
    },
    "./themes/*": {
      "import": {
        "types": "./dist/themes/*.d.mts",
        "default": "./dist/themes/*.mjs"
      },
      "require": {
        "types": "./dist/themes/*.d.ts",
        "default": "./dist/themes/*.js"
      }
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "storybook dev -p 9009 --no-open",
    "build:storybook": "storybook build -o ./storybook",
    "build": "tsdown",
    "build:dev": "tsdown",
    "build:prod": "tsdown",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typescript": "tsc --noEmit",
    "lint": "biome check src test .storybook",
    "lint:fix": "biome check --write src test .storybook",
    "format": "biome format --write src test .storybook",
    "semantic-release": "semantic-release",
    "cz": "git-cz"
  },
  "peerDependencies": {
    "react": ">= 19.0.0",
    "react-dom": ">= 19.0.0",
    "styled-components": ">= 6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "firebase-tools": "^11.4.2",
    "husky": "^8.0.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^19.0.3",
    "storybook": "^10.6.2",
    "styled-components": "^6.6.0",
    "tsdown": "^0.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {},
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
